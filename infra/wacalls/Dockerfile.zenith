# syntax=docker/dockerfile:1

# ------------------------------------------------------------
# Stage 1 - React client
# ------------------------------------------------------------
FROM node:22-bookworm-slim AS client-build

WORKDIR /src/client

COPY client/package*.json ./

RUN npm ci

COPY client/ ./

RUN npm run build


# ------------------------------------------------------------
# Stage 2 - Go server
# ------------------------------------------------------------
FROM golang:1.26-bookworm AS go-build

WORKDIR /src

COPY go.mod go.sum ./

RUN go mod download

COPY . .

COPY --from=client-build /src/client/dist ./client/dist

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/wacalls \
    ./cmd/server


# ------------------------------------------------------------
# Stage 3 - Runtime
# ------------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 wacalls \
    && useradd \
        --system \
        --uid 10001 \
        --gid wacalls \
        --home-dir /app \
        --create-home \
        wacalls \
    && mkdir -p /app/client /data \
    && chown -R wacalls:wacalls /app /data

WORKDIR /app

COPY --from=go-build /out/wacalls /usr/local/bin/wacalls
COPY --from=go-build /src/client/dist /app/client

USER wacalls

VOLUME ["/data"]

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/wacalls"]

CMD ["-addr", ":8080", "-db", "/data/wacalls.db", "-static", "/app/client", "-max-calls-per-session", "8"]
# Zenith CRM production/local configuration. Copy to .env.local and replace
# every placeholder secret before starting the stack.

POSTGRES_DB=zenith_crm
POSTGRES_USER=zenith
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zenith:replace-with-url-encoded-password@127.0.0.1:5432/zenith_crm
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

AUTH_SESSION_DAYS=30
AUTH_SESSION_COOKIE_NAME=zenith_session

# 32-byte AES keys encoded as 64 hexadecimal characters.
MESSAGING_CREDENTIALS_KEY=replace-with-64-hex-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional dedicated AES-256-GCM key. Falls back to ENCRYPTION_KEY.
# GOOGLE_CALENDAR_ENCRYPTION_KEY=replace-with-64-hex-characters

# Google Calendar OAuth web application. The callback must exactly match the
# authorized redirect URI in Google Cloud. Push requires a public HTTPS URL.
# GOOGLE_CALENDAR_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_CALENDAR_REDIRECT_URI=https://crm.example.com/api/zenith/integrations/google-calendar/oauth/callback
# GOOGLE_CALENDAR_PUSH_URL=https://crm.example.com/api/webhooks/zenith/google-calendar

# Shared only by the app and its internal workers.
ZENITH_WORKER_SECRET=replace-with-a-long-random-secret
VOICE_WEBHOOK_TOKEN=replace-with-a-long-random-secret
MESSAGING_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Internal app base URL for workers; Compose overrides this automatically.
# ZENITH_APP_URL=http://127.0.0.1:3000

# Required only for Meta Cloud API channels/webhook verification.
META_APP_SECRET=replace-with-meta-app-secret
# META_APP_ID=replace-with-meta-app-id

NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en
HOST_PORT=3000
WACALLS_PORT=18080
# Optional only when a separate browser origin must call WaCalls directly.
# WACALLS_ALLOWED_ORIGIN=http://localhost:5173

# Local-development tunnel hosts only, comma-separated and without schemes.
# ALLOWED_DEV_ORIGINS=dev.example.com

# One-time bootstrap values for `npm run auth:bootstrap`. Remove after use.
# ZENITH_BOOTSTRAP_EMAIL=owner@example.com
# ZENITH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# ZENITH_BOOTSTRAP_NAME=Owner
# ZENITH_BOOTSTRAP_ACCOUNT=Zenith

{
  "name": "zenith-crm",
  "version": "0.8.0",
  "private": true,
  "description": "Zenith CRM — CRM self-hosted multi-provider para WhatsApp, com PostgreSQL próprio e integrações Meta Cloud API, Evolution API e WaCalls.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "homepage": "https://github.com/carlosddsilva/zenith-crm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosddsilva/zenith-crm.git"
  },
  "bugs": {
    "url": "https://github.com/carlosddsilva/zenith-crm/issues"
  },
  "keywords": [
    "zenith-crm",
    "crm",
    "whatsapp",
    "evolution-api",
    "wacalls",
    "postgresql",
    "nextjs",
    "self-hosted",
    "whatsapp-business-api",
    "automation",
    "broadcast",
    "template"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:build": "node e2e/support/build-next.mjs",
    "test:e2e:infra:up": "docker compose -p zenith-crm-e2e -f e2e/docker-compose.yml up -d --wait postgres redis",
    "test:e2e:services:up": "docker compose -p zenith-crm-e2e -f e2e/docker-compose.yml up -d --wait app automation-worker",
    "test:e2e:infra:down": "docker compose -p zenith-crm-e2e -f e2e/docker-compose.yml down -v --remove-orphans",
    "test:e2e:migrate": "node --env-file=e2e/.env.e2e ./node_modules/drizzle-kit/bin.cjs migrate",
    "test:integration": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts src/app/api/zenith/contacts/crm06-cross-tenant.test.ts src/app/api/zenith/dashboard/crm07-aggregate.test.ts",
    "test:google-calendar-db": "node scripts/test-google-calendar-db.mjs",
    "test:ai-db": "node ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts src/lib/ai/ai-db.integration.test.ts",
    "test:watch": "vitest",
    "worker:google-calendar": "node scripts/google-calendar-worker.mjs",
    "worker:ai": "node scripts/ai-worker.mjs",
    "infra:check": "node --env-file=.env.local scripts/check-infra.mjs",
    "db:check": "node --env-file=.env.local scripts/check-database.mjs",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:backup": "node --env-file=.env.local scripts/postgres-backup.mjs",
    "db:restore:test": "node scripts/postgres-restore-test.mjs",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "auth:bootstrap": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@swc/helpers": "0.5.23",
    "@xyflow/react": "^12.11.2",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.5",
    "next-intl": "^4.13.5",
    "opus-recorder": "^8.0.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.3",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9"
  }
}
